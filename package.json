{
  "name": "registrygen",
  "author": "Alain Paumen, Hoogin bv",
  "repository": "https://github.com/alainpaumen/registrygen",
  "homepage": "https://github.com/alainpaumen/registrygen",
  "bugs": "https://github.com/alainpaumen/registrygen/issues",
  "version": "0.1.3",
  "description": "Generate registry.json files to setup a shadcn/ui registry",
  "main": "./dist/index.js",
  "bin": {
    "registrygen": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts /home/alain/Projects/hoogin/hoogin-registry/src/@registry/layout",
    "start:verbose": "tsx src/index.ts /home/alain/Projects/hoogin/hoogin-registry/src/@registry/layout -v",
    "test": "echo \"Error: no test specified\" && exit 1",
    "knip": "npx knip",
    "prepare": "npm run build"
  },
  "keywords": [
    "shadcn",
    "registry",
    "registry generator",
    "shadcn registry"
  ],
  "license": "ISC",
  "type": "module",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "tsx": "^4.21.0",
    "knip": "^5.82.1"
  }
}